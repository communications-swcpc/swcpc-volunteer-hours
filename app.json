{
  "expo": {
    "name": "Volunteer Hours",
    "slug": "swcpc-volunteer-hours",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d6a4f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.swcpc.volunteerhours",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow the app to use your camera to take photos of receipts.",
        "NSPhotoLibraryUsageDescription": "Allow the app to access your photo library so you can attach receipt images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "org.swcpc.volunteerhours"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos for receipt uploads.",
          "cameraPermission": "Allow the app to use your camera to take photos of receipts."
        }
      ],
      "expo-document-picker"
    ],
    "scheme": "volunteerhours",
    "extra": {
      "eas": {
        "projectId": "080139ed-e339-4675-a999-79f5fafada86"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/080139ed-e339-4675-a999-79f5fafada86"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
